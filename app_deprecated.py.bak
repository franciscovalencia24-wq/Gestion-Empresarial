    with t2:
        if "Seguro" not in vehiculo:
            bursatil = st.checkbox("Simular Fondos con Presencia Bursátil (Art. 107)", value=True)
        else:
            bursatil = False
            st.info("🛡️ Beneficios de Póliza Activos")

    if "audit_data" not in st.session_state:
