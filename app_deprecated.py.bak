        if t_pp != 100: st.warning(f"Suma propuesta: {t_pp}% (Debe ser 100%)")
        else: st.success("✅ Propuesta Principal equilibrada.")

    st.markdown("---")
    st.markdown("### 🏛️ Optimización Tributaria (Tax-Alpha)")
