                        <tr style="border: none; background-color: transparent;">
                            <td style="text-align: right; vertical-align: middle; border: none; padding-right: 12px;">
                                <span style="font-size: 11pt; color: #0A2342; font-weight: bold;">Digital Family Office Analytics</span><br>
                                <span style="font-size: 8pt; color: #6b7280;">Fecha de EmisiÃ³n: {fecha_hoy}</span>
                            </td>
                            <td style="text-align: right; width: 80px; vertical-align: middle; border: none; padding: 0;">
                                <img src="{altus_b64}" width="65">
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        
        <div style="text-align: right; font-size: 8pt; color: #6b7280; margin-bottom: 15px;">
            AnÃ¡lisis procesado cuantitativamente por <strong>Altus AI</strong> para uso exclusivo de FV AsesorÃ­as e Inversiones
        </div>

        <h1>{titulo}</h1>
        
        <p><strong>Instrumento Analizado:</strong> {ticker}</p>
        <p><strong>Destinatario:</strong> {destinatario}</p>

        <div class="markdown-content">
            {html_content}
        </div>
        
        <div class="corp-desc">
            <strong>Sobre FV AsesorÃ­as e Inversiones</strong><br>
            Somos un Multi-Family Office Digital impulsado por Inteligencia Artificial. Combinamos la tecnologÃ­a de una Startup WealthTech con la exclusividad de la banca privada para auditar portafolios de forma cuantitativa, cruzar normativas tributarias complejas (como el Estate Tax) y entregar estrategias patrimoniales hiper-personalizadas de grado institucional.
        </div>
        
        <div class="contact-info">
            Contacto: contacto@fv-inversiones.com | +569 89779862
        </div>
        
        <div id="footer_content">
            FV AsesorÃ­as e Inversiones | AnÃ¡lisis Confidencial | PÃ¡gina <pdf:pagenumber> de <pdf:pagecount>
        </div>
    </body>
    </html>
    """
    
    result_bytes = io.BytesIO()
    pisa_status = pisa.CreatePDF(html_template, dest=result_bytes, encoding='utf-8')
    
    if pisa_status.err:
        return None
    return result_bytes.getvalue()

