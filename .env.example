# ─── Base de Datos ────────────────────────────────────────────────────────────
# Ruta a la base de datos SQLite local (no cambiar a menos que uses Postgres)
DATABASE_URL=sqlite:///data/processed/prospectos.db

# ─── Apollo.io — Enriquecimiento de Contactos ─────────────────────────────────
# Obtén tu API Key en: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=tu_api_key_de_apollo_aqui

# ─── TransUnion Chile — Minería de Teléfonos ──────────────────────────────────
# Credenciales de acceso a DataBúsqueda de TransUnion
TRANSUNION_USER=tu_usuario_transunion
TRANSUNION_PASS=tu_contrasena_transunion

# ─── Google Custom Search API ─────────────────────────────────────────────────
# Obtén tu API Key y CX en: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=tu_google_api_key_aqui
GOOGLE_SEARCH_CX=tu_google_cx_aqui

# ─── Equifax / DataFinder Chile — Enriquecimiento Premium ─────────────────────
# Licencia corporativa (Límite estricto de 100 consultas mensuales)
DATAFINDER_USER=tu_usuario_equifax
DATAFINDER_PASS=tu_clave_equifax
DATAFINDER_URL=https://web.datafinder.cl
DATAFINDER_MAX_MONTHLY_QUERIES=100
DATAFINDER_HEADLESS=True
